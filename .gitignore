# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and secrets
.env
.venv

# Jupyter
.ipynb_checkpoints

# macOS
.DS_Store

# Generic caches
.*cache
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/


# Generated data files
data/conversations.db
data/eval_results.json
data/index_checkpoint.json

# Coverage report (generated by pytest --cov)
.coverage
htmlcov/
coverage.xml

# Legacy graph data (we use Neo4j now)
data/convfinqa_graph
data/convfinqa_graph.wal

# Neo4j local volume (generated by docker-compose; do NOT commit, can be 1+ GB with transaction logs)
data/neo4j/

# Dump files we don't ship
# Keep only dev.dump committed; ignore experimental dumps and tar backups
data/neo4j_dump/*.tar.gz
data/neo4j_dump/*.dump.bak
data/neo4j_dump/*.dump.archive
data/neo4j_dump/neo4j.dump

# Editor / tool settings
.claude/
.idea/
.vscode/

# OS / temp
*.swp
*.swo
*~
Thumbs.db

# Eval result dumps (run output, large, regeneratable via `main evaluate`)
data/eval_results*.json

# One-off debugging / recovery scripts
scripts/rerun_failed_mode3.py
