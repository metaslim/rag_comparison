OPENAI_API_KEY=your-openai-api-key-here

# Neo4j (started via docker-compose up)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Optional overrides
OPENAI_MODEL=gpt-5-mini                     # Agent CoT reasoning model
GRAPHITI_MODEL=gpt-4o-mini                  # Graphiti entity/edge extraction during indexing
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JUDGE_MODEL=gpt-4o-mini                     # LLM-as-judge model (used by `evaluate --judge`)
CONVERSATIONS_DB_PATH=data/conversations.db
INDEX_CHECKPOINT_PATH=data/index_checkpoint.json
DATASET_PATH=data/convfinqa_dataset.json
LOG_LEVEL=INFO
